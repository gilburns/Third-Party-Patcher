#!/bin/zsh
# Refreshes patcher/DuplicateLabelsSnapshot.swift, the copy of the duplicate label list
# built into patcher, from the list served on main. Run before a release build.
# patcher only uses the built-in copy when it has never downloaded the list.

set -euo pipefail
cd "${0:A:h}"

url="https://raw.githubusercontent.com/gilburns/Third-Party-Patcher/main/LabelLists/duplicate-labels.json"
out="patcher/DuplicateLabelsSnapshot.swift"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

curl --fail --silent --show-error --location --output "$tmp" "$url"
plutil -convert xml1 -o /dev/null "$tmp"   # fails unless the download is valid JSON

{
    print -r -- '//'
    print -r -- '//  DuplicateLabelsSnapshot.swift'
    print -r -- '//  patcher'
    print -r -- '//'
    print -r -- '//  Generated by update_duplicate_labels_snapshot.zsh — do not edit.'
    print -r -- '//  The duplicate label list built into patcher, used only when the hosted list has'
    print -r -- '//  never been downloaded on this Mac.'
    print -r -- '//'
    print -r -- ''
    print -r -- 'enum DuplicateLabelsSnapshot {'
    print -r -- '    static let json = #"""'
    cat "$tmp"
    print -r -- '"""#'
    print -r -- '}'
} > "$out"

echo "Updated $out from $url"
